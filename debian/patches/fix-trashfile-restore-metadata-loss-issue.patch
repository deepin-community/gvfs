+static void
+trash_item_move_metadata (const char *source,
+                           const char *dest)
+{
+  MetaLookupCache *cache;
+  MetaTree *tree1, *tree2;
+  char *tree_path1, *tree_path2;
+  GVfsMetadata *proxy;
+
+  cache = meta_lookup_cache_new ();
+  tree1 = meta_lookup_cache_lookup_path (cache, source, 0, FALSE, &tree_path1);
+  tree2 = meta_lookup_cache_lookup_path (cache, dest, 0, FALSE, &tree_path2);
+
+  if (tree1 != NULL && tree2 != NULL && tree1 == tree2)
+    {
+      proxy = meta_tree_get_metadata_proxy ();
+      if (proxy != NULL)
+        {
+          const char *metatreefile = meta_tree_get_filename (tree1);
+
+          gvfs_metadata_call_move (proxy, metatreefile,
+                                    tree_path1, tree_path2,
+                                    NULL, NULL, NULL);
+        }
+    }
+
+  if (tree1 != NULL)
+    {
+      meta_tree_unref (tree1);
+      g_free (tree_path1);
+    }
+  if (tree2 != NULL)
+    {
+      meta_tree_unref (tree2);
+      g_free (tree_path2);
+    }
+
+  meta_lookup_cache_free (cache);
+}
